# ==========================================================
# ServEasy Provider Portal Security Configuration
# ==========================================================
Options -Indexes

<FilesMatch "(\.env|\.env\..*|\.log|\.sql|\.git|composer\.(json|lock))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

DirectoryIndex index.php index.html
